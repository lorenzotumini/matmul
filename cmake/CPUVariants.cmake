# Separate targets keep each experiment's instruction set local to its source.
function(matmul_cpu_variant target source definition)
    add_library(${target} STATIC ${source})
    target_include_directories(${target} PRIVATE include)
    target_link_libraries(matmul PRIVATE ${target})
    target_compile_definitions(matmul PRIVATE ${definition}=1)
endfunction()

set(MATMUL_CPU_VARIANT_TARGETS "")
# SIMD, register tiling and the combined direct path use AVX/FMA.
if(MATMUL_ENABLE_AVX AND MATMUL_TARGET_X86_64 AND MATMUL_COMPILER_HAS_AVX)
    if(MSVC)
        set(_avx_fma_flags /arch:AVX2 /fp:strict)
        check_c_compiler_flag(/arch:AVX2 MATMUL_COMPILER_HAS_FMA_TARGET)
    else()
        set(_avx_fma_flags -mavx -mfma -ffp-contract=off)
        check_c_compiler_flag(-mfma MATMUL_COMPILER_HAS_FMA_TARGET)
    endif()
    if(MATMUL_COMPILER_HAS_FMA_TARGET)
        matmul_cpu_variant(matmul_avx src/simd_avx.c MATMUL_HAVE_SIMD_AVX)
        matmul_cpu_variant(matmul_register_avx src/register_avx.c MATMUL_HAVE_REGISTER_AVX)
        matmul_cpu_variant(matmul_cpu_direct src/cpu_combined_direct.c MATMUL_HAVE_CPU_DIRECT)
        if(TARGET matmul_openmp)
            target_link_libraries(matmul_cpu_direct PRIVATE OpenMP::OpenMP_C)
        endif()
        foreach(_target matmul_avx matmul_register_avx matmul_cpu_direct)
            target_compile_options(${_target} PRIVATE ${_avx_fma_flags})
            if(NOT WIN32)
                target_link_libraries(${_target} PRIVATE m)
            endif()
        endforeach()
        list(APPEND MATMUL_CPU_VARIANT_TARGETS matmul_avx matmul_register_avx matmul_cpu_direct)
    endif()
endif()

option(MATMUL_ENABLE_AVX512 "Build sixteen-float SIMD and packed combined variants" ON)
if(MATMUL_ENABLE_AVX512 AND MATMUL_TARGET_X86_64)
    if(MSVC)
        set(_avx512_flags /arch:AVX512 /fp:strict)
        check_c_compiler_flag(/arch:AVX512 MATMUL_COMPILER_HAS_AVX512)
    elseif(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
        set(_avx512_flags -mavx512f -mfma -ffp-contract=off)
        check_c_compiler_flag(-mavx512f MATMUL_COMPILER_HAS_AVX512)
    endif()
    if(MATMUL_COMPILER_HAS_AVX512)
        matmul_cpu_variant(matmul_avx512 src/simd_avx512.c MATMUL_HAVE_AVX512)
        target_compile_options(matmul_avx512 PRIVATE ${_avx512_flags})
        if(NOT WIN32)
            target_link_libraries(matmul_avx512 PRIVATE m)
        endif()
        list(APPEND MATMUL_CPU_VARIANT_TARGETS matmul_avx512)
        if(TARGET matmul_cpu_direct)
            matmul_cpu_variant(matmul_cpu_packed src/cpu_combined_packed.c MATMUL_HAVE_CPU_PACKED)
            target_compile_options(matmul_cpu_packed PRIVATE ${_avx512_flags})
            if(TARGET matmul_openmp)
                target_link_libraries(matmul_cpu_packed PRIVATE OpenMP::OpenMP_C)
            endif()
            list(APPEND MATMUL_CPU_VARIANT_TARGETS matmul_cpu_packed)
        endif()
    endif()
endif()
